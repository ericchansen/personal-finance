# Copy to .env and use files outside the repository. NEVER commit .env or secrets.

# Pinned multi-platform PostgreSQL 17.11 image. Validate a new digest before upgrading.
POSTGRES_IMAGE=postgres:17.11-bookworm@sha256:051f7b7b3abdd564d5d1bd1e8c4b9c1b6e77087d1dd22020ede611c096a272e0

# Absolute external paths. Password files must contain one strong password and no newline.
POSTGRES_ADMIN_PASSWORD_FILE=D:/finance-data/postgres-shadow/secrets/admin-password.txt
POSTGRES_LOADER_PASSWORD_FILE=D:/finance-data/postgres-shadow/secrets/loader-password.txt
POSTGRES_AGENT_PASSWORD_FILE=D:/finance-data/postgres-shadow/secrets/agent-password.txt
POSTGRES_BACKUP_PASSWORD_FILE=D:/finance-data/postgres-shadow/secrets/backup-password.txt
POSTGRES_BACKUP_DIR=D:/finance-data/postgres-shadow/backups

# Loopback-only by default. 55432 avoids the usual local PostgreSQL port.
POSTGRES_BIND_ADDR=127.0.0.1
POSTGRES_PORT=55432

POSTGRES_DB=finance_shadow_authority
POSTGRES_USER=finance_shadow_bootstrap
FINANCE_SHADOW_ENVIRONMENT=shadow-authority-v1
# Set to confirmed only while all pre-0007 writers are manually stopped.
FINANCE_SHADOW_LEGACY_QUIESCED=
# Used only with compose.legacy-upgrade.yml while crossing migration 0007.
POSTGRES_LEGACY_DATA_DIR=D:/finance-data/postgres/data

# Verification policy; verification reports drift but never removes a backup.
BACKUP_RETENTION_DAYS=30
BACKUP_MINIMUM_COUNT=1

# Used only by separate disposable integration and restore-rehearsal projects.
POSTGRES_TEST_PASSWORD_FILE=D:/finance-data/postgres-shadow/secrets/integration-password.txt
POSTGRES_REHEARSAL_PASSWORD_FILE=D:/finance-data/postgres-shadow/secrets/rehearsal-password.txt
POSTGRES_TEST_BIND_ADDR=127.0.0.1
POSTGRES_TEST_PORT=55433

# Optional TLS override: docker compose -f compose.yml -f compose.tls.yml up -d.
POSTGRES_TLS_CERT_FILE=D:/finance-data/postgres-shadow/tls/server.crt
POSTGRES_TLS_KEY_FILE=D:/finance-data/postgres-shadow/tls/server.key
