# Copy to .env and fill in. NEVER commit .env — it is gitignored.
# Run ./init-env.ps1 to generate the secret key and password hash for you.

# Tested upstream image. Keep both the version and digest; validate upgrades in
# an isolated staging instance before changing this reference.
WF_IMAGE=wealthfolio/wealthfolio:3.7.0@sha256:de137d64acf712c5c71093b27ecc98ccc1dbbbf00befdb684bed531cdb40069a

# Absolute path to the data directory, OUTSIDE this repository.
# This is where the Wealthfolio SQLite database lives.
WF_DATA_DIR=D:/documents/finance-data/wealthfolio

# Interface to publish on. Keep 127.0.0.1 unless it sits behind Tailscale
# or an authenticating reverse proxy.
WF_BIND_ADDR=127.0.0.1
WF_PORT=8088

# openssl rand -base64 32
WF_SECRET_KEY=replace-me

# Argon2id PHC hash of your login password.
# Wrap in SINGLE QUOTES so Docker Compose does not interpolate the '$' characters.
WF_AUTH_PASSWORD_HASH='replace-me'

WF_AUTH_TOKEN_TTL_MINUTES=60

# Explicit CORS origins. The server refuses to start with "*" while auth is
# enabled. Include every origin you will browse from.
WF_CORS_ALLOW_ORIGINS=http://localhost:8088,http://127.0.0.1:8088
